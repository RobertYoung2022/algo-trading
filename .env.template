# Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit the .env file to git!

# CoinMarketCap API - Get from: https://pro.coinmarketcap.com/account
CMC_API_KEY=your_cmc_api_key_here

# Coinbase Exchange API - Get from: https://exchange.coinbase.com/profile/api
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_API_SECRET=your_coinbase_api_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here

# PriceHawk API (if needed)
PH_API_KEY=your_ph_api_key_here
PH_SECRET_KEY=your_ph_secret_key_here