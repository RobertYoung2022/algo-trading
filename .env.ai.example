# 🤖 AI AGENTS CONFIGURATION
# ⚠️ Copy this to .env.ai and fill in your actual API keys
# 🔒 NEVER commit .env.ai to git!

# ============================================
# AI MODEL API KEYS
# ============================================

# Anthropic Claude (Required for complex trading decisions)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY_HERE

# DeepSeek (Required for cost-effective operations)
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY_HERE

# ============================================
# MARKET DATA API KEYS (Optional but recommended)
# ============================================

# Moon Dev API (for advanced market intelligence)
# Get your key from: https://api.moondev.com/
MOONDEV_API_KEY=YOUR_MOONDEV_KEY_HERE

# BirdEye API (for Solana token data)
# Get your key from: https://birdeye.so/
BIRDEYE_API_KEY=YOUR_BIRDEYE_KEY_HERE

# CoinGecko API (for crypto market data)
# Get your key from: https://www.coingecko.com/en/api
COINGECKO_API_KEY=YOUR_COINGECKO_KEY_HERE

# ============================================
# EXCHANGE API KEYS (If live trading)
# ============================================

# Add your exchange API credentials here
# Example for Binance:
# BINANCE_API_KEY=YOUR_BINANCE_KEY_HERE
# BINANCE_API_SECRET=YOUR_BINANCE_SECRET_HERE

# ============================================
# NOTIFICATION SETTINGS (Optional)
# ============================================

# Telegram Bot Token (for trade alerts)
# TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ============================================
# AI MODEL CONFIGURATION
# ============================================

# Primary model for complex analysis (claude-3-5-sonnet-20241022, gpt-4, etc.)
AI_PRIMARY_MODEL=claude-3-5-sonnet-20241022

# Secondary model for cost-effective operations
AI_SECONDARY_MODEL=deepseek-chat

# Default temperature for AI responses (0.0 = deterministic, 1.0 = creative)
AI_TEMPERATURE=0.3

# Maximum tokens for AI responses
AI_MAX_TOKENS=4000

# ============================================
# AGENT CONFIGURATION
# ============================================

# Enable/disable specific agents
ENABLE_FUNDING_AGENT=true
ENABLE_LIQUIDATION_AGENT=true
ENABLE_WHALE_AGENT=true
ENABLE_RBI_AGENT=true
ENABLE_RISK_AGENT=true

# Agent execution intervals (in seconds)
FUNDING_CHECK_INTERVAL=300       # 5 minutes
LIQUIDATION_CHECK_INTERVAL=180   # 3 minutes
WHALE_CHECK_INTERVAL=300         # 5 minutes

# Risk management thresholds
MAX_LOSS_USD=500
MAX_POSITION_PERCENTAGE=20
MINIMUM_BALANCE_USD=100

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# Set to 'true' for paper trading, 'false' for live trading
PAPER_TRADING=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Enable verbose AI reasoning output
VERBOSE_AI_OUTPUT=false
