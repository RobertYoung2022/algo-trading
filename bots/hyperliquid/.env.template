# 🚀 CRYPTO MOMENTUM BOT ENVIRONMENT CONFIGURATION 🚀
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ====================
# EXCHANGE CREDENTIALS
# ====================

# Hyperliquid API Credentials
HYPERLIQUID_PRIVATE_KEY=your_hyperliquid_private_key_here
HYPERLIQUID_API_KEY=your_api_key_here_if_needed
HYPERLIQUID_SECRET=your_secret_here_if_needed

# ====================
# TRADING CONFIGURATION
# ====================

# Trading Mode: 'paper' for testing, 'live' for real trading
TRADING_MODE=paper

# Assets to trade (comma-separated)
ASSETS=HBAR,CRO,LINK

# Risk Management
MAX_POSITION_SIZE=5.0  # Maximum 5% per position
RISK_PERCENTAGE=2.0    # Risk 2% per trade
MAX_DAILY_LOSS=5.0     # Stop trading at 5% daily loss
KILL_SWITCH_LOSS=10.0  # Emergency stop at 10% loss

# ====================
# BOT CONFIGURATION
# ====================

# Signal Check Interval (seconds)
SIGNAL_CHECK_INTERVAL=300  # Check every 5 minutes

# Position Update Interval (seconds)
POSITION_UPDATE_INTERVAL=60  # Update positions every minute

# Metrics Update Interval (seconds)
METRICS_UPDATE_INTERVAL=600  # Update metrics every 10 minutes

# ====================
# MONITORING & ALERTS
# ====================

# Enable kill switch protection
ENABLE_KILL_SWITCH=true

# Enable alerts
ENABLE_ALERTS=true

# Alert webhook URL (Discord, Slack, etc.)
ALERT_WEBHOOK=https://your-webhook-url-here

# ====================
# DASHBOARD SETTINGS
# ====================

# Dashboard port
DASHBOARD_PORT=8080

# Enable real-time dashboard
ENABLE_DASHBOARD=true

# ====================
# LOGGING CONFIGURATION
# ====================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log to file
LOG_TO_FILE=true

# Log file path
LOG_FILE=crypto_momentum_bot.log

# ====================
# ADVANCED SETTINGS
# ====================

# Correlation threshold for position limits
CORRELATION_THRESHOLD=0.7

# Maximum concurrent positions
MAX_CONCURRENT_POSITIONS=3

# Minimum trade interval (seconds)
MIN_TRADE_INTERVAL=300

# Maximum daily trades
MAX_DAILY_TRADES=10

# Pause after consecutive losses
PAUSE_AFTER_LOSSES=3